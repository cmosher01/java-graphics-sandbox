<synth>
    <style id="default">
        <font name="SansSerif" size="14"/>
        <state>
            <color value="#333333" type="BACKGROUND"/>
            <color value="#F0F0F0" type="FOREGROUND"/>
        </state>
    </style>
    <bind style="default" type="region" key=".*"/>

    <style id="internalFrame">
        <opaque value="true"/>
        <state>
            <color value="#252526" type="BACKGROUND"/>
        </state>
    </style>
    <bind style="internalFrame" type="region" key="RootPane"/>
    <bind style="internalFrame" type="region" key="InternalFrame"/>

    <style id="titleBar">
        <opaque value="true"/>
        <state>
            <color value="#1E1E1E" type="BACKGROUND"/>
            <color value="#007ACC" type="FOREGROUND"/>
        </state>
    </style>
    <bind style="titleBar" type="region" key="InternalFrameTitlePane"/>
</synth>
